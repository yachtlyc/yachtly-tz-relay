# yachtly-tz-relay — environment variables

# Shared secret. When set, WebSocket clients must include ?token=<value> in the URL.
# When empty (the default), the relay accepts any local-network client without a token.
# The Yachtly Connect dashboard currently passes auth via subscribe payload, not URL,
# so leave this empty during dashboard testing. See README for details.
YACHTLY_RELAY_TOKEN=

# UDP port to listen for TimeZero NMEA 0183 output. Default: 11101 (TimeZero default).
YACHTLY_RELAY_UDP_PORT=11101

# WebSocket port the dashboard connects to. Default: 8765.
YACHTLY_RELAY_WS_PORT=8765

# Maximum simultaneous WebSocket clients. Default: 10.
YACHTLY_RELAY_MAX_CLIENTS=10
